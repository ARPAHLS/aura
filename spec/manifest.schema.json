{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arpacorp.net/schemas/aura/manifest/v1",
  "title": "AuraManifest",
  "description": "Birth declaration for an AURA session.",
  "type": "object",
  "required": ["manifest_version", "bindings"],
  "properties": {
    "manifest_version": { "type": "integer", "const": 1 },
    "bindings": {
      "type": "array",
      "items": { "$ref": "#/$defs/TypeBinding" },
      "minItems": 1
    },
    "sequencer": { "$ref": "sequencer.schema.json" },
    "middleware": { "$ref": "middleware-policy.schema.json" },
    "spectrum": { "$ref": "#/$defs/Spectrum" },
    "trust_tier": {
      "enum": ["ephemeral", "unverified", "verified_live_id"],
      "description": "Derived from identity binding; caps effective AURA level"
    }
  },
  "$defs": {
    "TypeBinding": {
      "type": "object",
      "required": ["type", "config"],
      "properties": {
        "type": {
          "type": "string",
          "description": "Namespaced type id, e.g. arpa.brain.gemini"
        },
        "config": { "type": "object" }
      }
    },
    "Spectrum": {
      "type": "object",
      "properties": {
        "level": {
          "enum": ["low", "mid", "high", "full"]
        },
        "services": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Field services to wire at session open (audit is spine-only metadata)"
        },
        "service_config": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "description": "Per-service observer preset overrides"
          }
        },
        "strict_services": {
          "type": "boolean",
          "default": false,
          "description": "Emit observer.alert (not just note) for unknown service names"
        },
        "identity_required": {
          "type": "boolean",
          "description": "Require verified operator identity at session open (high/full default true when set)"
        },
        "output": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "EscalationRule": {
      "type": "object",
      "required": ["on"],
      "properties": {
        "on": {
          "type": "string",
          "description": "Trigger event kind: slo.missed, conformance.drift, observer.alert, constraint.violated"
        },
        "actions": {
          "type": "array",
          "items": { "type": "string" },
          "description": "log, alert, nudge, pause, email:addr, wake, custom"
        },
        "after_minutes": {
          "type": "integer",
          "description": "Schedule metadata for external playbooks; in-session triggers fire immediately"
        },
        "id": { "type": "string" }
      }
    }
  }
}
